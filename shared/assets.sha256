# Brand assets that more than one repository carries a copy of.
#
# Each row is: <sha256>  <path in the repo being checked>  <home>
#
# The home is where the file is maintained; every other copy is a distribution
# artefact and must be byte-identical to it. The `shared-files` job in the
# hygiene gate checks each row whose path exists in the repo it is checking, and
# skips rows whose home repository is the one being checked (GOV-R12).
#
# GitHub renders a README from the repository it lives in, so a repo that shows
# the mark in its README needs the file in its own tree. The copies cannot be
# removed; this file is what keeps them honest.
#
# `logo.svg` and `logo-on-ink.svg` are the horizontal lockup under the names the
# READMEs reach for. Renaming them in every README would be churn for no gain,
# so the home is recorded here instead.

16002f7a2b1373fef8f1277ac1e37b59a9a9b4ead37da329541e8c2990b318a6  .github/logo.svg                       brand:assets/logo/lockup-horizontal.svg
a8cac7ba0c0727b9672df91eb989f66208c0b98d595437b981a6ac2fe0e9af13  .github/logo-on-ink.svg                brand:assets/logo/lockup-horizontal-on-ink.svg
49644a8c94f0d413a7bff5b2252701362b111086926f41835013ad904a9174c1  .github/discord.svg                    .github:.github/discord.svg
c1092d6b7340c2b63cd075a1cb3465fcb94b795ac99a51a93368c71b93def56c  .github/nightworks-dark.png            .github:.github/nightworks-dark.png
e27b53ced4cb69dd3f9ae3d9510cfc78d174fd2f5fd5dd3ed315acb445286b6c  .github/nightworks-white.png           .github:.github/nightworks-white.png

# The site serves the same marks from its own tree, because a built page cannot
# reach into another repository at request time.

16002f7a2b1373fef8f1277ac1e37b59a9a9b4ead37da329541e8c2990b318a6  public/brand/lockup-horizontal.svg     brand:assets/logo/lockup-horizontal.svg
16002f7a2b1373fef8f1277ac1e37b59a9a9b4ead37da329541e8c2990b318a6  public/brand/logo.svg                  brand:assets/logo/lockup-horizontal.svg
a8cac7ba0c0727b9672df91eb989f66208c0b98d595437b981a6ac2fe0e9af13  public/brand/logo-on-ink.svg           brand:assets/logo/lockup-horizontal-on-ink.svg
d33779134df78f31080e74d87002473acc571f6e4d8f4bdc5912c6cc7cff10c8  public/brand/lockup-horizontal-knockout.svg  brand:assets/logo/lockup-horizontal-knockout.svg
05b00eaabccd502b6580aa32021bcead3ca40ee5f908b71a271d7f36641da6ea  public/brand/mark-small.svg            brand:assets/logo/mark-small.svg
05b00eaabccd502b6580aa32021bcead3ca40ee5f908b71a271d7f36641da6ea  public/favicon.svg                     brand:assets/logo/mark-small.svg
df2e55f37f26f07f27d9b9e3e71c2640d25c2d1dcc0cdfb1af448b369affdb89  public/brand/wordmark.svg              brand:assets/logo/wordmark.svg
82edae07f1463181938af7124679c21b420dfd8705f4e6a16c83850ed86924f2  public/brand/wordmark-mono.svg         brand:assets/logo/wordmark-mono.svg
49644a8c94f0d413a7bff5b2252701362b111086926f41835013ad904a9174c1  public/brand/discord.svg               .github:.github/discord.svg
c1092d6b7340c2b63cd075a1cb3465fcb94b795ac99a51a93368c71b93def56c  public/brand/nightworks-dark.png       .github:.github/nightworks-dark.png
